APP_NAME="PROCURA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Buka aplikasi lewat alamat INI PERSIS (127.0.0.1 dan localhost dianggap situs berbeda oleh browser).
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database PostgreSQL (buat dulu database kosong: procura_db) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=procura_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Email sistem lewat Gmail API ---
MAIL_MAILER=gmail_api
MAIL_FROM_ADDRESS="noreply@procura.local"
MAIL_FROM_NAME="PROCURA - Sistem Pengadaan"
# Scope yang dibutuhkan: https://www.googleapis.com/auth/gmail.send
# CARA TERCEPAT: salin credentials.json + token.json dari proyek Inventaris/MKP ke storage/app/credentials/
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_CA_BUNDLE=
# Mode lokal: bila Gmail belum siap, kode OTP dicatat di storage/logs/laravel.log (hanya APP_ENV=local)
GMAIL_LOCAL_LOG_FALLBACK=true

# --- Hash password: Argon2id ---
HASH_DRIVER=argon2id
HASH_ARGON_MEMORY=65536
HASH_ARGON_TIME=4
HASH_ARGON_THREADS=1
HASH_VERIFY=true

# --- Aplikasi ---
PROCURA_REGISTRATION=open
PROCURA_INTERNAL_APPROVAL_THRESHOLD=25000000
PROCURA_DEFAULT_TAX=11
PROCURA_SEED_DEMO=true
PROCURA_API_RATE_LIMIT=120

# Admin awal (opsional; membuat akun tanpa registrasi/OTP saat `php artisan migrate --seed`)
PROCURA_ADMIN_NAME="Administrator"
PROCURA_ADMIN_EMAIL=
PROCURA_ADMIN_PASSWORD=

PROCURA_BACKUP_KEEP=10
PROCURA_PG_DUMP_PATH=

VITE_APP_NAME="${APP_NAME}"
