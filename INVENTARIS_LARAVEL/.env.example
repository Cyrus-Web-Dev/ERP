APP_NAME="Sistem Inventaris"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost/inventaris-laravel/public

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Sesuaikan dengan instalasi PostgreSQL kamu.
# Nama database SENGAJA disamakan dengan project lama: inventaris_db
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=inventaris_db
DB_USERNAME=postgres
DB_PASSWORD=

# Masih mau pakai MySQL/XAMPP? Comment 6 baris di atas, lalu un-comment ini:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=inventaris_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# ==== Email (dipakai untuk verifikasi email, 2FA login, lupa password) ====
# Default: Gmail API (OAuth2), SAMA seperti project PHP native sebelumnya.
# Cara pakai (paling gampang kalau kamu sudah pernah setup OAuth sebelumnya):
#   1. Salin token.json & credentials.json yang LAMA ke folder:
#      storage/app/credentials/token.json
#      storage/app/credentials/credentials.json
#   2. Biarkan MAIL_MAILER=gmailapi di bawah ini. Selesai, tidak perlu isi apapun lagi.
#
# Kalau tidak punya file token.json (setup dari nol), isi 3 variabel di bawah
# sebagai fallback (didapat dari Google Cloud Console > OAuth 2.0 Client):
MAIL_MAILER=gmailapi
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Alternatif kalau mau pakai SMTP biasa untuk testing cepat (ganti MAIL_MAILER=smtp di atas):
# Rekomendasi: Mailtrap (https://mailtrap.io) - gratis, tidak perlu App Password Google,
# email langsung masuk ke inbox virtual buat testing.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@inventaris.local"
MAIL_FROM_NAME="${APP_NAME}"

# ==== Pengaturan keamanan (mengikuti project lama) ====
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ==== Integrasi PROCURA (Sistem Pengadaan) ====
# Buat klien API "Sistem Inventaris" di PROCURA (menu Integrasi API), lalu salin token & rahasia webhook ke sini.
PROCURA_URL=http://127.0.0.1:8000/api/v1
PROCURA_TOKEN=
PROCURA_WEBHOOK_SECRET=
PROCURA_TIMEOUT=10
