APP_NAME="PAYBRIDGE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Buka aplikasi lewat alamat INI PERSIS (127.0.0.1 dan localhost dianggap situs berbeda oleh browser).
# Port 8003 supaya tidak bentrok: PROCURA 8000, MKP 8001, SDM 8002, PAYBRIDGE 8003 (lihat docs/INTEGRASI.md).
APP_URL=http://127.0.0.1:8003
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL wajib: PAYBRIDGE memakai trigger & partial index khusus PostgreSQL untuk integritas data) ---
# Buat dulu database kosong:  CREATE DATABASE paybridge;
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=paybridge
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
# PRODUCTION (HTTPS): set true supaya cookie sesi tidak pernah dikirim lewat HTTP biasa.
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Email sistem lewat Gmail API (OTP login, persetujuan, slip gaji PDF, peringatan) ---
MAIL_MAILER=gmail_api
MAIL_FROM_ADDRESS="noreply@paybridge.local"
MAIL_FROM_NAME="PAYBRIDGE"
# CARA TERCEPAT: salin credentials.json + token.json dari SDM/MKP/Inventaris yang sudah jalan ke storage/app/credentials/
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_CA_BUNDLE=
GMAIL_LOCAL_LOG_FALLBACK=true

# --- Hashing password: argon2id (BUKAN bcrypt) ---
HASH_DRIVER=argon2id
ARGON_MEMORY=37888
ARGON_TIME=3
ARGON_THREADS=1

# --- Integrasi SDM (HRIS) ---
# URL REST API SDM untuk payroll. Token dibuat di SDM > Integrasi Payroll > Klien baru.
SDM_URL=http://127.0.0.1:8002/api/payroll/v1
SDM_TOKEN=
# Rahasia webhook SDM -> PAYBRIDGE (tampil sekali di SDM saat klien dibuat)
SDM_WEBHOOK_SECRET=

# --- REST API milik PAYBRIDGE (dipakai Keuangan & SDM) ---
PAY_API_RATE_LIMIT=120
PAY_WEBHOOK_TIMEOUT=8

# --- Kontrol anti-kecurangan ---
PAY_SOD_ENFORCED=true
PAY_DUAL_APPROVAL_THRESHOLD=500000000
PAY_SALARY_JUMP_PCT=25
PAY_BANK_CHANGE_WINDOW_DAYS=30
PAY_LARGE_INPUT_AMOUNT=10000000
PAY_ROUND_INPUT_UNIT=1000000
PAY_DEDUCTION_CAP_PCT=50

# --- Aturan perhitungan ---
PAY_OT_DIVISOR=173
PAY_ABSENCE_DIVISOR=scheduled
PAY_TAXABLE_EMPLOYER_PREMIUMS=kes,jkk,jkm
PAY_ROUND_TO_RUPIAH=true
PAY_PAYSLIP_ENCRYPT=true

# --- Jangkar rantai audit: hash terbaru dikirim harian ke email ini (auditor/direksi), pisahkan koma ---
PAY_AUDIT_ANCHOR_EMAILS=

# --- Pendaftaran mandiri (akun menunggu persetujuan Admin Payroll) ---
PAY_REGISTRATION_ENABLED=true

# --- Notifikasi tambahan (opsional) ---
FONNTE_TOKEN=
PAY_WHATSAPP_ADMIN_NUMBER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Anti-bot Cloudflare Turnstile (opsional) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Keamanan production ---
PAY_CSP=report-only
PAY_FORCE_HTTPS=false

PAY_BACKUP_KEEP=10
PAY_PG_DUMP_PATH=

# Akun super-admin awal, dibuat saat `php artisan migrate --seed`
PAY_ADMIN_NAME="Administrator Payroll"
PAY_ADMIN_EMAIL=
PAY_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
