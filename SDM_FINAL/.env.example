APP_NAME="SDM HRIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Buka aplikasi lewat alamat INI PERSIS (127.0.0.1 dan localhost dianggap situs berbeda oleh browser).
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (buat dulu database kosong di PostgreSQL: CREATE DATABASE sdm_hris;) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sdm_hris
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# file = tidak butuh tabel database, lebih cepat & lebih sedikit yang bisa error
SESSION_DRIVER=file
SESSION_LIFETIME=120
# PENTING utk PRODUCTION (bukan localhost): set true kalau situs sudah pakai HTTPS,
# supaya cookie sesi TIDAK PERNAH dikirim lewat koneksi HTTP biasa (anti session hijacking).
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Email sistem (kode OTP login, reset password, notifikasi cuti/payroll) lewat Gmail API ---
MAIL_MAILER=gmail_api
MAIL_FROM_ADDRESS="noreply@sdm-hris.local"
MAIL_FROM_NAME="SDM HRIS"

# CARA TERCEPAT: salin credentials.json + token.json dari proyek MKP/Inventaris yang sudah jalan
# ke storage/app/credentials/  (tidak perlu isi apa pun di bawah ini).
# Cara lain: isi tiga baris ini (lihat README > "Menyiapkan Gmail API").
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Bila muncul error SSL "cURL error 60" (Windows/XAMPP), isi path file cacert.pem:
GMAIL_CA_BUNDLE=
# Mode lokal: kalau Gmail belum siap, kode OTP dicatat di storage/logs/laravel.log (hanya APP_ENV=local)
GMAIL_LOCAL_LOG_FALLBACK=true

# --- Pengaturan HR ---
# Batas hari sebelum kadaluarsa dokumen (kontrak/sertifikat) mulai diingatkan
SDM_DOCUMENT_EXPIRY_REMINDER_DAYS=30
# Batas menit keterlambatan sebelum status absensi otomatis "terlambat"
SDM_LATE_TOLERANCE_MINUTES=15
# Jam kerja standar (dipakai kalkulasi lembur & keterlambatan)
SDM_WORK_START_TIME=08:00
SDM_WORK_END_TIME=17:00

# --- Komponen BPJS & PPh 21 (persentase resmi per 2026, boleh disesuaikan bila regulasi berubah) ---
SDM_BPJS_KESEHATAN_EMPLOYEE_PCT=1
SDM_BPJS_KESEHATAN_COMPANY_PCT=4
SDM_BPJS_KESEHATAN_SALARY_CAP=12000000
SDM_BPJS_JHT_EMPLOYEE_PCT=2
SDM_BPJS_JHT_COMPANY_PCT=3.7
SDM_BPJS_JKK_COMPANY_PCT=0.24
SDM_BPJS_JKM_COMPANY_PCT=0.3
SDM_BPJS_JP_EMPLOYEE_PCT=1
SDM_BPJS_JP_COMPANY_PCT=2
SDM_BPJS_JP_SALARY_CAP=10547400

# Backup database (menu Backup Data): jumlah file yang disimpan
SDM_BACKUP_KEEP=10
# Opsional bila pg_dump tidak ditemukan otomatis, mis. C:\PostgreSQL\16\bin\pg_dump.exe
SDM_PG_DUMP_PATH=

# --- REST API (mobile/integrasi eksternal) ---
# Token API kedaluwarsa dalam berapa menit (default 30 hari). Kosongkan utk tidak pernah kedaluwarsa.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
# Isi hanya bila ada APLIKASI WEB terpisah (bukan mobile native) yang perlu memanggil /api/v1/*
# dari domain lain, contoh: https://portal.perusahaan.com,https://app-lain.perusahaan.com
CORS_ALLOWED_ORIGINS=

# --- Pendaftaran mandiri ---
# true = siapa saja bisa mendaftar sendiri (akun menunggu persetujuan Admin HR, kecuali pendaftar
# PERTAMA yang otomatis jadi super-admin). false = hanya Admin HR yang bisa membuat akun.
SDM_REGISTRATION_ENABLED=true

# --- Hari kerja & hari libur ---
SDM_WORK_DAYS_PER_WEEK=5
# Sumber hari libur nasional/cuti bersama (dataset publik, BUKAN API resmi pemerintah - selalu
# cocokkan dengan SKB 3 Menteri). Punya cache + file cadangan bawaan, jadi aman walau sumber ini mati.
SDM_HOLIDAY_API=true
SDM_HOLIDAY_SOURCE_URL=https://raw.githubusercontent.com/guangrei/APIHariLibur_V2/main/calendar.min.json
SDM_HOLIDAY_CACHE_HOURS=12

# --- Geofencing absensi (opsional; kosongkan LAT/LNG untuk menonaktifkan) ---
SDM_OFFICE_LAT=
SDM_OFFICE_LNG=
SDM_OFFICE_RADIUS_M=200
# true = check-in di luar radius DITOLAK. false (default) = tetap diterima, hanya dicatat di keterangan.
SDM_GEOFENCE_ENFORCE=false

# --- Notifikasi WhatsApp (opsional, lewat gateway pihak ketiga Fonnte - https://fonnte.com,
# BUKAN WhatsApp Cloud API resmi Meta) & Telegram (bot resmi, gratis) ---
FONNTE_TOKEN=
SDM_WHATSAPP_ADMIN_NUMBER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Verifikasi anti-bot Cloudflare Turnstile (opsional, gratis, tanpa teka-teki gambar) ---
# Dipakai di: form registrasi, lupa password, lamar kerja publik. Kosongkan utk nonaktif.
# Key uji coba resmi Cloudflare (SELALU lolos, aman dipakai saat development):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Keamanan tambahan untuk PRODUCTION ---
# off | report-only | enforce. Mulai dari report-only (lihat README bagian Keamanan).
SDM_CSP=off
# true HANYA kalau situs sudah punya sertifikat HTTPS aktif (otomatis TIDAK aktif di APP_ENV=local).
SDM_FORCE_HTTPS=false

# --- Hashing password: argon2id (default, lebih tahan brute-force GPU/ASIC dibanding bcrypt) ---
# Ganti ke "bcrypt" HANYA bila PHP di server belum mendukung Argon2 (jarang terjadi di PHP modern).
HASH_DRIVER=argon2id
ARGON_MEMORY=37888
ARGON_TIME=3
ARGON_THREADS=1

# --- Migrasi data lama (opsional, hanya dipakai perintah `php artisan sdm:import-legacy`) ---
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=perusahaan
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# Akun admin awal, dibuat otomatis saat `php artisan migrate --seed` (tanpa perlu OTP)
SDM_ADMIN_NAME="Administrator HR"
SDM_ADMIN_EMAIL=
SDM_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# --- Integrasi Payroll (PAYBRIDGE) ---
# Rahasia webhook PAYBRIDGE -> SDM (tampil sekali di PAYBRIDGE > Integrasi API saat klien "SDM" dibuat)
PAYROLL_WEBHOOK_SECRET=
PAYROLL_PORTAL_URL=http://127.0.0.1:8003
# true = kunci modul payroll bawaan SDM (dialihkan ke PAYBRIDGE). Aktifkan SETELAH PAYBRIDGE berjalan.
SDM_PAYROLL_EXTERNAL=false
# true = hari kerja tanpa catatan absensi dihitung alpha. Default false (aman bila absensi belum dipakai penuh).
SDM_COUNT_UNRECORDED_AS_ALPHA=false
